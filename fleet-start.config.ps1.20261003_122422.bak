# Per-repo fleet start config for tahoma2d-mcp
# Edit ports/backend target here - start.ps1 is fleet-standard.
@{
    Name         = 'tahoma2d-mcp'
    BackendPort  = 11013
    FrontendPort = 11012
    HealthPath   = '/api/status'
    WebRoot      = 'webapp'
    Backend = @{
        Kind          = 'uvicorn'
        UvicornTarget = 'tahoma2d_mcp.server:asgi_app'
        SyncExtras    = @('dev')
        Env           = @{ WEB_PORT = '11013' }
    }
    Frontend = @{
        Kind           = 'vite-npm'
        PackageManager = 'npm'
        PortEnvVar     = 'VITE_PORT'
        ApiTargetEnv   = 'VITE_API_TARGET'
    }
}
